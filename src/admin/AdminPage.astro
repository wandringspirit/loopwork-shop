            </p>
            <label class="field"><span>Name</span><input class="input" maxlength="60" required x-model="creating.name" /></label>
            <div class="field-row">
              <label class="field">
                <span>Category</span>
                <select class="input" x-model="creating.category">
                  <template x-for="category in categories" x-bind:key="category.id">
                    <option x-bind:value="category.id" x-text="category.name" x-bind:selected="category.id === creating.category"></option>
                  </template>
                </select>
              </label>
              <label class="field"><span>Price (₹)</span><input class="input" inputmode="numeric" required x-model="creating.price" /></label>
            </div>
            <p class="form-error" x-show="createError" x-text="createError"></p>
            <div class="modal-actions">
              <button type="button" class="btn btn-quiet" x-on:click="creating = null">Cancel</button>
              <button type="submit" class="btn btn-primary" x-bind:disabled="busy">Create product</button>
            </div>
          </form>
        </template>
      </div>

      <p class="toast" role="status" x-show="toastText" x-text="toastText" x-cloak></p>
    </div>

    <script>
      import './admin.js';
    </script>
  </body>
</html>

