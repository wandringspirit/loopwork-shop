---
import type { CareSymbolName } from '../lib/care';

interface Props {
  symbol: CareSymbolName;
}

// Simplified laundry care symbols, the kind printed on a yarn label.
const { symbol } = Astro.props;
const washTub = symbol === 'hand-wash' || symbol === 'machine-wash-cold';
---

<svg class="care-symbol" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {
    washTub && (
      <Fragment>
        <path d="M3.5 12.5 6.6 26h18.8l3.1-13.5"></path>
        <path d="M3.5 12.5q3.125-2.5 6.25 0t6.25 0 6.25 0 6.25 0"></path>
      </Fragment>
    )
  }
  {
    symbol === 'hand-wash' && (
      <path d="M12.8 23.5v-6.2a1.2 1.2 0 0 1 2.4 0v1.2m0-2.4a1.2 1.2 0 0 1 2.4 0v2.4m0-1.2a1.2 1.2 0 0 1 2.4 0v3.6c0 1.6-1.2 2.6-2.8 2.6"></path>
    )
  }
  {symbol === 'machine-wash-cold' && <circle class="filled" cx="16" cy="19.5" r="1.7"></circle>}
  {
    symbol === 'no-bleach' && (
      <Fragment>
        <path d="M16 5 29 27H3Z"></path>
        <path d="m8 11 16 16M24 11 8 27"></path>
      </Fragment>
    )
  }
  {
    symbol === 'dry-flat' && (
      <Fragment>
        <rect x="5" y="5" width="22" height="22" rx="1.5"></rect>
        <path d="M9.5 16h13"></path>
      </Fragment>
    )
  }
  {
    symbol === 'no-tumble-dry' && (
      <Fragment>
        <rect x="5" y="5" width="22" height="22" rx="1.5"></rect>
        <circle cx="16" cy="16" r="7"></circle>
        <path d="m4 4 24 24M28 4 4 28"></path>
      </Fragment>
    )
  }
  {
    symbol === 'no-iron' && (
      <Fragment>
        <path d="M5 23.5h22c0-6.2-3.4-10.5-9-10.5h-6.3c-2.6 0-4.6 1.8-5.4 4.4Z"></path>
        <path d="M10.5 13c0-2.8 1.3-4.5 4-4.5h8"></path>
        <path d="m5 5 22 22M27 5 5 27"></path>
      </Fragment>
    )
  }
</svg>

<style>
  .care-symbol {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .filled {
    fill: currentColor;
    stroke: none;
  }
</style>
