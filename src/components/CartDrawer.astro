<dialog class="drawer" data-cart-drawer aria-labelledby="cart-drawer-title">
  <div class="drawer-head">
    <h2 id="cart-drawer-title" class="drawer-title">Your cart <span class="drawer-count" data-drawer-count></span></h2>
    <button type="button" class="drawer-close" data-drawer-close aria-label="Close cart">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <div class="chain drawer-chain" aria-hidden="true"></div>

  <p class="drawer-added" data-drawer-added role="status" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
    Added to your cart
  </p>

  <p class="drawer-message" data-drawer-loading>Loading your cart…</p>

  <ul class="cart-lines drawer-lines" data-drawer-lines hidden></ul>

  <div class="drawer-empty" data-drawer-empty hidden>
    <p class="drawer-empty-title">Your cart is empty</p>
    <p>Find something soft to fill it.</p>
    <a class="btn btn-outline" href="/shop/">Browse the shop</a>
  </div>

  <div class="drawer-foot" data-drawer-foot hidden>
    <p class="drawer-subtotal"><span>Subtotal</span><span data-drawer-subtotal></span></p>
    <p class="drawer-note">Shipping is confirmed on WhatsApp. No payment now.</p>
    <a class="btn btn-primary btn-block" href="/cart/">Review order &amp; add details</a>
    <button type="button" class="btn btn-quiet btn-block" data-drawer-close>Keep shopping</button>
  </div>
</dialog>

<style>
  .drawer {
    width: min(27rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--cotton);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .drawer[open] {
    display: flex;
    flex-direction: column;
  }

  .drawer::backdrop {
    background: rgb(30 36 51 / 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] {
      animation: drawer-in 0.38s var(--ease);
    }

    .drawer[open]::backdrop {
      animation: backdrop-in 0.38s ease;
    }
  }

  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  .drawer svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .drawer-chain {
    flex: none;
  }

  .drawer-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
  }

  .drawer-count {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
  }

  .drawer-close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .drawer-close:hover {
    background: var(--oat);
  }

  .drawer-added {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 1.25rem 0;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--mint-soft);
    color: var(--mint);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .drawer-message {
    padding: 2rem 1.25rem;
    color: var(--muted);
  }

  .drawer-lines {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 1.25rem 1rem;
  }

  .drawer-empty {
    flex: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    color: var(--ink-soft);
  }

  .drawer-empty-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink);
  }

  .drawer-foot {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .drawer-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-lg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .drawer-note {
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>

<script>
  import { formatPrice } from '../lib/format';
  import { cart } from '../scripts/cart';
  import { bindLineActions, renderCartLines, resolveCart } from '../scripts/cart-view';
  import { loadCatalog } from '../scripts/catalog-client';

  const dialog = document.querySelector<HTMLDialogElement>('[data-cart-drawer]');

  if (dialog) {
    const part = <T extends HTMLElement>(selector: string) => dialog.querySelector<T>(selector)!;
    const lineList = part<HTMLUListElement>('[data-drawer-lines]');
    const loading = part('[data-drawer-loading]');
    const empty = part('[data-drawer-empty]');
    const foot = part('[data-drawer-foot]');
    const subtotal = part('[data-drawer-subtotal]');
    const count = part('[data-drawer-count]');
    const added = part('[data-drawer-added]');
    let highlightKey: string | undefined;

    const render = async () => {
      try {
        const summary = resolveCart(cart.lines(), await loadCatalog());
        const isEmpty = summary.lines.length === 0;
        loading.hidden = true;
        empty.hidden = !isEmpty;
        lineList.hidden = isEmpty;
        foot.hidden = isEmpty;
        count.textContent = isEmpty ? '' : `(${summary.count})`;
        subtotal.textContent = formatPrice(summary.subtotal);
        renderCartLines(lineList, summary.lines, highlightKey);
        highlightKey = undefined;
      } catch {
        loading.hidden = false;
        loading.textContent = 'We couldn’t load your cart. Please refresh the page.';
      }
    };

    bindLineActions(lineList);
    cart.subscribe(() => {
      if (dialog.open) void render();
    });

    window.addEventListener('cart:open', (event) => {
      const addedKey = (event as CustomEvent<{ addedKey?: string }>).detail?.addedKey;
      highlightKey = addedKey;
      added.hidden = !addedKey;
      if (!dialog.open) dialog.showModal();
      void render();
    });

    // Close on the ✕ or "Keep shopping" buttons, or a click on the dimmed backdrop.
    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target === dialog || target.closest('[data-drawer-close]')) dialog.close();
    });
  }
</script>
