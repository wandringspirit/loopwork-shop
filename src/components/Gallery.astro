---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  photos: { src: ImageMetadata; alt: string; focus?: string }[];
}

const { name, photos } = Astro.props;
const focus = (value?: string) => (value ? `object-position: ${value}` : undefined);
---

<div class="gallery" data-gallery>
  <div class="track" data-track tabindex="0" role="region" aria-label={`Photos of ${name}`}>
    {
      photos.map((photo, index) => (
        <figure class="slide" data-slide>
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 60rem) 52vw, 100vw"
            priority={index === 0}
            style={focus(photo.focus)}
          />
        </figure>
      ))
    }
  </div>
  {
    photos.length > 1 && (
      <div class="thumbs" role="group" aria-label="Choose a photo">
        {photos.map((photo, index) => (
          <button
            type="button"
            class="thumb"
            data-thumb
            aria-label={`Show photo ${index + 1} of ${photos.length}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <Image src={photo.src} alt="" widths={[160]} sizes="72px" loading="lazy" style={focus(photo.focus)} />
          </button>
        ))}
      </div>
    )
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    border-radius: var(--radius-lg);
    background: var(--yarn-soft, var(--oat));
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .thumb {
    width: 4.5rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--oat);
    opacity: 0.6;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }

  .thumb:hover {
    opacity: 1;
  }

  .thumb[aria-pressed='true'] {
    border-color: var(--ink);
    opacity: 1;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    if (!track || thumbs.length === 0) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const markCurrent = (index: number) =>
      thumbs.forEach((thumb, i) => thumb.setAttribute('aria-pressed', String(i === index)));

    thumbs.forEach((thumb, index) =>
      thumb.addEventListener('click', () => {
        track.scrollTo({ left: index * track.clientWidth, behavior: reduceMotion ? 'auto' : 'smooth' });
        markCurrent(index);
      }),
    );

    // Keep the thumbnails in sync when the photos are swiped.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) markCurrent(slides.indexOf(entry.target as HTMLElement));
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((slide) => observer.observe(slide));
  });
</script>
