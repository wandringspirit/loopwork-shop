---
import Logo from './Logo.astro';
import type { YarnColour } from '../lib/yarn';
import { site } from '../site.config';

// Each link's colour matches the band at the top of its page.
const links: { href: string; label: string; colour: YarnColour }[] = [
  { href: '/shop/', label: 'Shop', colour: 'berry' },
  { href: '/custom-orders/', label: 'Custom orders', colour: 'lilac' },
  { href: '/about/', label: 'About', colour: 'mint' },
  { href: '/contact/', label: 'Contact', colour: 'teal' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Main">
      <ul id="main-nav" class="nav-list" role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class={`yarn-${link.colour}`} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a href="/cart/" class="cart-button" data-cart-button aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.5 8.5h13l-1.1 12h-10.8z"></path>
          <path d="M9 10.5V7.5a3 3 0 0 1 6 0v3"></path>
        </svg>
        <span class="cart-label">Cart</span>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-button>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="chain header-trim" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(244 245 240 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    transition: box-shadow 0.2s;
  }

  .site-header.is-scrolled {
    box-shadow: 0 12px 24px -22px rgb(30 36 51 / 0.45);
  }

  /* A trim of chain stitches in every yarn colour along the bottom edge. */
  .header-trim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }

  .brand {
    margin-right: auto;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
  }

  .nav-list a {
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .nav-list a:hover {
    background: var(--yarn-soft);
  }

  .nav-list a[aria-current='page'] {
    background: var(--yarn-soft);
    color: var(--yarn-deep);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.8rem 0 0.85rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cotton);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .cart-button:hover {
    background: var(--berry);
  }

  .cart-button svg,
  .menu-button svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cart-count {
    display: grid;
    place-items: center;
    min-width: 1.45rem;
    height: 1.45rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--marigold-bright);
    color: var(--ink);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .cart-count.bump {
    animation: bump 0.45s var(--ease);
  }

  @keyframes bump {
    40% {
      transform: scale(1.3);
    }
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .menu-button {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1.5px solid var(--line-strong);
      border-radius: 50%;
      background: var(--paper);
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto;
      display: none;
      padding: 0.25rem var(--gutter) 1rem;
      background: var(--cotton);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 24px -20px rgb(30 36 51 / 0.4);
    }

    .site-header[data-open] .nav {
      display: block;
    }

    .nav-list {
      flex-direction: column;
    }

    .nav-list a {
      padding: 0.85rem 0.75rem;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      font-size: var(--text-md);
    }

    .nav-list a:hover {
      color: var(--yarn-deep);
    }

    .cart-label {
      display: none;
    }
  }
</style>

<script>
  import { cart, openCartDrawer } from '../scripts/cart';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const cartButton = header?.querySelector<HTMLAnchorElement>('[data-cart-button]');
  const countBadge = header?.querySelector<HTMLElement>('[data-cart-count]');
  const menuButton = header?.querySelector<HTMLButtonElement>('[data-menu-button]');

  if (header && cartButton && countBadge && menuButton) {
    let lastCount = cart.count();

    const renderCount = () => {
      const count = cart.count();
      countBadge.textContent = String(count);
      countBadge.hidden = count === 0;
      cartButton.setAttribute('aria-label', count === 0 ? 'Cart, empty' : `Cart, ${count} ${count === 1 ? 'item' : 'items'}`);
      if (count > lastCount) {
        countBadge.classList.remove('bump');
        void countBadge.offsetWidth; // restart the animation
        countBadge.classList.add('bump');
      }
      lastCount = count;
    };

    renderCount();
    cart.subscribe(renderCount);

    cartButton.addEventListener('click', (event) => {
      if (location.pathname.startsWith('/cart')) return;
      event.preventDefault();
      openCartDrawer();
    });

    menuButton.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') !== 'true';
      menuButton.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
    });

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
