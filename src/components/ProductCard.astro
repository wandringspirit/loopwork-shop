---
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import { productUrl, type Product } from '../lib/catalog';
import { formatPrice } from '../lib/format';
import type { YarnColour } from '../lib/yarn';

interface Props {
  product: Product;
  categoryName: string;
  /** The category's colour, used for the label and the photo background. */
  colour: YarnColour;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { product, categoryName, colour, eager = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { name, price, status, photos, category } = product.data;
const [cover, alternate] = photos;
const widths = [320, 480, 640, 800];
const sizes = '(min-width: 78rem) 290px, (min-width: 70rem) 23vw, (min-width: 48rem) 31vw, 47vw';
const focus = (value?: string) => (value ? `object-position: ${value}` : undefined);
---

<article
  class:list={['card', `yarn-${colour}`, { 'is-sold-out': status === 'sold-out' }]}
  data-card
  data-category={category.id}
  data-price={price}
>
  <div class="card-media">
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      style={focus(cover.focus)}
    />
    {
      alternate && (
        <Image
          src={alternate.src}
          alt=""
          widths={widths}
          sizes={sizes}
          loading="lazy"
          class="card-img-alt"
          style={focus(alternate.focus)}
        />
      )
    }
    {status !== 'available' && <StatusBadge status={status} class="card-status" />}
  </div>
  <div class="card-body">
    <p class="card-category yarn-dot">{categoryName}</p>
    <Heading class="card-name">
      <a href={productUrl(product.id)}>{name}</a>
    </Heading>
    <p class="card-price">{formatPrice(price)}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--yarn-soft);
  }

  .card-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 0.45s var(--ease),
      transform 0.8s var(--ease);
  }

  .card-media :global(.card-img-alt) {
    opacity: 0;
  }

  @media (hover: hover) {
    .card:hover .card-media :global(.card-img-alt) {
      opacity: 1;
    }

    .card:hover .card-media :global(img) {
      transform: scale(1.03);
    }
  }

  .card-media :global(.card-status) {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    box-shadow: 0 1px 3px rgb(30 36 51 / 0.15);
  }

  .card.is-sold-out .card-media :global(img) {
    filter: grayscale(0.45);
  }

  .card-body {
    display: grid;
    gap: 0.15rem;
  }

  .card-category {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--yarn-deep);
  }

  .card-name {
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .card-name a {
    text-decoration: none;
  }

  /* The whole card is clickable through the product name link. */
  .card-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card-name a:focus-visible {
    outline: none;
  }

  .card-name a:focus-visible::after {
    outline: 2.5px solid var(--berry);
    outline-offset: 4px;
  }

  .card:hover .card-name a {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  .card-price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
</style>
