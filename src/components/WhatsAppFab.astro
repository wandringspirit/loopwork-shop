---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink } from '../lib/whatsapp';
import { site } from '../site.config';
---

<a class="fab" href={whatsappLink(`Hi ${site.name}! `)} target="_blank" rel="noopener" aria-label={`Chat with ${site.name} on WhatsApp`}>
  <WhatsAppIcon />
</a>

<style>
  .fab {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--mint);
    color: #fff;
    box-shadow: var(--shadow-lift);
  }

  .fab :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }

  @media (min-width: 48rem) {
    .fab {
      display: none;
    }
  }
</style>
