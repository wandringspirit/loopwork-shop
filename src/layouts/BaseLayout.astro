---
import '@fontsource/caprasimo/400.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import AdminLink from '../components/AdminLink.astro';
import CartDrawer from '../components/CartDrawer.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import heroImage from '../assets/site/hero.jpg';
import { hasSampleProducts } from '../lib/catalog';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  showWhatsApp?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image = heroImage,
  noindex = false,
  showWhatsApp = true,
  jsonLd,
} = Astro.props;

const previewMode = await hasSampleProducts();
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · Handmade crochet`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareImageUrl = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f5f0" />
    {(noindex || previewMode) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.demo?.enabled ? <DemoBanner /> : previewMode && <PreviewBanner />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    {showWhatsApp && <WhatsAppFab />}
    {import.meta.env.DEV && <AdminLink />}
  </body>
</html>
