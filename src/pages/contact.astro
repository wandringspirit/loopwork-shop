---
import PageHeader from '../components/PageHeader.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappLink } from '../lib/whatsapp';
import { site } from '../site.config';

const topics = [
  'A question about a piece',
  'An order I’ve sent',
  'A custom piece',
  'Gifting or bulk orders',
  'Something else',
];
---

<BaseLayout
  title="Contact"
  description={`Questions about a piece or an order? Message ${site.name} on WhatsApp. We usually reply ${site.replyTime}.`}
>
  <PageHeader title="Say hello" eyebrow="Contact" colour="teal">
    <p class="page-lede">Questions about a piece, an order or an idea? We usually reply {site.replyTime}.</p>
  </PageHeader>

  <div class="wrap contact">
    <div class="contact-layout">
      <form class="contact-form" data-contact-form novalidate>
        <div class="field">
          <label for="contact-name">Your name</label>
          <input id="contact-name" name="name" class="input" autocomplete="name" maxlength="80" aria-describedby="contact-name-error" />
          <p id="contact-name-error" class="field-error" data-error-for="name"></p>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="contact-topic">What's it about?</label>
            <select id="contact-topic" name="topic" class="input">
              {topics.map((topic) => <option>{topic}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="contact-order">Order number <span class="optional">(if you have one)</span></label>
            <input id="contact-order" name="orderId" class="input" maxlength="12" placeholder="ORD-7K3QX" autocapitalize="characters" />
          </div>
        </div>
        <div class="field">
          <label for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            class="input"
            rows="6"
            maxlength="1000"
            aria-describedby="contact-message-error"></textarea>
          <p id="contact-message-error" class="field-error" data-error-for="message"></p>
        </div>
        <button class="btn btn-primary" type="submit">
          <WhatsAppIcon />
          Send on WhatsApp
        </button>
        <p class="form-note" data-form-status hidden>
          WhatsApp should open with your message ready to send. Didn't open?
          <a class="text-link" data-status-link href={whatsappLink()} target="_blank" rel="noopener">Send it on WhatsApp</a>.
        </p>
      </form>

      <aside class="contact-aside" aria-labelledby="channels-title">
        <h2 id="channels-title" class="block-title">Other ways to reach us</h2>
        <ul class="channels" role="list">
          <li>
            <a class="channel yarn-mint" href={whatsappLink()} target="_blank" rel="noopener">
              <span class="channel-label yarn-dot">WhatsApp</span>
              <span class="channel-value">{site.whatsappDisplay}</span>
              <span class="channel-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="channel yarn-berry" href={site.instagramUrl} target="_blank" rel="noopener">
              <span class="channel-label yarn-dot">Instagram</span>
              <span class="channel-value">{site.instagramHandle}</span>
              <span class="channel-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="channel yarn-lilac" href={`mailto:${site.email}`}>
              <span class="channel-label yarn-dot">Email</span>
              <span class="channel-value">{site.email}</span>
              <span class="channel-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
        <p>Looking for delivery times or care tips? The <a class="text-link" href="/faq/">FAQ</a> probably has the answer.</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .contact-layout {
    display: grid;
    align-items: start;
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .contact-form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .contact-form .btn {
    justify-self: start;
  }

  .contact-aside {
    display: grid;
    gap: 1.25rem;
  }

  .contact-aside > p {
    color: var(--ink-soft);
  }

  .channels {
    border-top: 1px solid var(--line);
  }

  .channel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .channel-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .channel-value {
    grid-column: 1;
    overflow-wrap: anywhere;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .channel-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: var(--text-lg);
    transition: transform 0.2s var(--ease);
  }

  .channel:hover .channel-value {
    color: var(--yarn-deep);
  }

  .channel:hover .channel-arrow {
    transform: translateX(4px);
  }
</style>

<script>
  import { site } from '../site.config';
  import { setupEnquiryForm } from '../scripts/enquiry';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    setupEnquiryForm(form, {
      rules: [
        { name: 'name', check: (value) => (value.length >= 2 ? '' : 'Please enter your name.') },
        { name: 'message', check: (value) => (value.length >= 5 ? '' : 'Please write a short message.') },
      ],
      message: (data) => {
        const get = (key: string) => String(data.get(key) ?? '').trim();
        const lines = [`Hi ${site.name}! ${get('topic')}.`];
        if (get('orderId')) lines.push(`Order: ${get('orderId').toUpperCase()}`);
        lines.push('', get('message'), '', `– ${get('name')}`);
        return lines.join('\n');
      },
    });
  }
</script>
