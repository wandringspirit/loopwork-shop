---
import '@fontsource/caprasimo/400.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { Image } from 'astro:assets';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import heroImage from '../assets/site/hero.jpg';
import offer from '../data/offer.json';
import { formatPrice } from '../lib/format';
import { formatWhatsApp, site } from '../site.config';

// The sales page for selling this shop as a done-for-you website. Only part of the demo site:
// `npm run starter` leaves it (and src/data/offer.json) out of the copy made for a client.
// Prices and add-ons live in src/data/offer.json; your contact number in settings.json → demo.

const { sellerName, sellerWhatsapp } = site.demo;
const pitch = "Hi! I saw the Loopwork demo shop and I'd like a shop website like it for my business.";
const contactUrl = `https://wa.me/${sellerWhatsapp}?text=${encodeURIComponent(pitch)}`;
const title = 'A shop website for your handmade business';
const description =
  'Your own shop website with your products, your name and orders straight to your WhatsApp. No monthly platform fee.';
const canonical = new URL('/for-sellers/', Astro.site);

const features = [
  { colour: 'berry', title: 'Your own website', text: 'Your shop name on your own domain, not a page on someone else’s marketplace.' },
  { colour: 'teal', title: 'Orders on WhatsApp', text: 'Customers fill a cart and send the whole order to your WhatsApp, with an order number.' },
  { colour: 'marigold', title: 'Made for phones', text: 'Fast and easy to use on a phone, where most of your Instagram buyers are.' },
  { colour: 'mint', title: 'Colours and sizes', text: 'Products can have options, and show ready to ship, made to order or sold out.' },
  { colour: 'lilac', title: 'Custom orders', text: 'A page where people describe a commission: idea, colours, size and budget.' },
  { colour: 'coral', title: 'No monthly fee', text: 'Hosting runs on a free plan. You only pay for your domain, about ₹700–1,200 a year.' },
];

const steps = [
  { title: 'Send your details', text: 'Photos, prices and a few lines about your shop, on WhatsApp.' },
  { title: 'We build it', text: 'Your shop is ready to review in about a week.' },
  { title: 'Go live', text: 'We connect your domain and test an order with you.' },
  { title: 'Keep it fresh', text: 'Update products yourself, or let the care plan handle it.' },
];

const faqs = [
  { q: 'Do I need any technical skills?', a: 'No. Send us your photos and prices and we do the rest. With the care plan you send changes on WhatsApp.' },
  { printed: false, q: 'Can customers pay on the website?', a: 'Yes, with the Online payments add-on: Razorpay for UPI, cards and netbanking in India, PayPal or Stripe for buyers abroad. Without it, you confirm orders and take payment on WhatsApp as you do today.' },
  { q: 'Who owns the domain?', a: 'You do. It is registered in your name, and you renew it each year.' },
  { printed: false, q: 'What does it cost each month?', a: 'Nothing, unless you choose the care plan. Hosting runs on a free plan; the domain is a yearly cost of about ₹700–1,200.' },
  { q: 'Is it only for crochet?', a: 'No. It suits any handmade or small-batch seller: candles, jewellery, embroidery, bakes, art prints and more.' },
];

const rupees = (price: number) => formatPrice(price);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f5f0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="wrap topbar">
      <p class="topbar-name">{sellerName || 'Shop websites'} <span>for handmade sellers</span></p>
      <a class="text-link" href="/">See the demo shop</a>
      <p class="topbar-print">
        WhatsApp <a href={contactUrl}>{formatWhatsApp(sellerWhatsapp)}</a> · Demo:
        <a href={new URL('/', Astro.site).href}>{new URL('/', Astro.site).host}</a>
      </p>
    </header>

    <main>
      <section class="band yarn-berry scallop-bottom intro">
        <div class="wrap intro-grid">
          <div class="intro-copy">
            <p class="eyebrow">For crochet, craft and handmade sellers</p>
            <h1 class="display intro-title">Your own shop website, with orders on WhatsApp.</h1>
            <p class="intro-lede">
              Your products, your name, your domain. Customers browse, fill a cart and send the order straight to your
              WhatsApp. You confirm and take payment the way you already do.
            </p>
            <div class="intro-actions">
              <a class="btn btn-primary" href={contactUrl}><WhatsAppIcon /> Chat on WhatsApp</a>
              <a class="btn btn-outline" href="/">Try the demo shop</a>
            </div>
            <ul class="intro-facts" role="list">
              <li class="yarn-dot yarn-teal">Ready in about a week</li>
              <li class="yarn-dot yarn-marigold">No monthly platform fee</li>
              <li class="yarn-dot yarn-lilac">Online payments if you want them</li>
            </ul>
          </div>

          <figure class="intro-media">
            <Image
              src={heroImage}
              alt="A crochet bunny and a vase of crochet flowers from the demo shop"
              widths={[400, 640, 880]}
              sizes="(min-width: 60rem) 36vw, 100vw"
              priority
              class="intro-img"
            />
            <figcaption class="chat" aria-label="An order as it arrives on WhatsApp">
              <span class="chat-head"><WhatsAppIcon /> New order</span>
              <span>Hi Loopwork! I'd like to order:</span>
              <span>• 1 × Carrot Bunny (Peach) — ₹899</span>
              <span>• 2 × Bobble Coasters — ₹698</span>
              <span class="chat-ref">Order ref: ORD-7K3QX</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="features-title">
        <h2 id="features-title" class="display section-title">What you get</h2>
        <ul class="features" role="list">
          {
            features.map((feature) => (
              <li class:list={['feature', `yarn-${feature.colour}`]}>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section wrap" aria-labelledby="steps-title">
        <h2 id="steps-title" class="display section-title">How it works</h2>
        <ol class="steps" role="list">
          {
            steps.map((step, index) => (
              <li>
                <span class="step-num" aria-hidden="true">{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section wrap" aria-labelledby="plans-title">
        <h2 id="plans-title" class="display section-title">Plans</h2>
        <div class="plans">
          {
            offer.plans.map((plan) => (
              <article class:list={['plan', `yarn-${plan.colour}`, { 'plan-popular': plan.popular }]}>
                {plan.popular && <p class="plan-badge">Most popular</p>}
                <h3 class="display plan-name">{plan.name}</h3>
                <p class="plan-price">
                  {rupees(plan.price)} <span>{plan.per}</span>
                </p>
                <p class="plan-blurb">{plan.blurb}</p>
                <ul class="plan-list" role="list">
                  {plan.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        <h3 class="addons-title">Add-ons</h3>
        <ul class="addons" role="list">
          {
            offer.addOns.map((addOn) => (
              <li>
                <p class="addon-head">
                  <strong>{addOn.name}</strong>
                  <span>
                    {addOn.from && 'from '}
                    {rupees(addOn.price)}
                    {addOn.per && ` ${addOn.per}`}
                  </span>
                </p>
                <p>{addOn.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section wrap" aria-labelledby="faq-title">
        <h2 id="faq-title" class="display section-title">Questions</h2>
        <div class="faqs">
          {
            faqs.map((faq) => (
              <div class:list={['faq', { 'faq-screen-only': faq.printed === false }]}>
                <h3>{faq.q}</h3>
                <p>{faq.a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="band yarn-teal scallop-top outro" aria-labelledby="outro-title">
        <div class="wrap outro-inner">
          <h2 id="outro-title" class="display section-title">Let's build your shop</h2>
          <p>Send a message with your shop name and a few product photos. We'll reply with a plan and a date.</p>
          <a class="btn btn-primary" href={contactUrl}><WhatsAppIcon /> Chat on WhatsApp</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    background: var(--cotton);
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 1rem;
  }

  .topbar-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .topbar-name span {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .intro {
    padding-block: clamp(2rem, 1.25rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .intro-grid {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .intro-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }

  .intro-copy {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .intro-title {
    max-width: 16ch;
    font-size: clamp(2.1rem, 1.3rem + 3.6vw, 4rem);
  }

  .intro-lede {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
  }

  .intro-actions .btn {
    flex: 1 1 auto;
  }

  @media (min-width: 40rem) {
    .intro-actions .btn {
      flex: 0 0 auto;
    }
  }

  .intro-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .intro-media {
    position: relative;
    margin: 0 0 1.5rem;
  }

  .intro-media :global(.intro-img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* A WhatsApp-style message bubble showing what an order looks like when it lands. */
  .chat {
    position: absolute;
    right: 0.75rem;
    bottom: -1.5rem;
    display: grid;
    gap: 0.15rem;
    max-width: min(18rem, 88%);
    padding: 0.7rem 0.9rem;
    border-radius: 14px 14px 4px 14px;
    background: #dcf8c6;
    color: var(--ink);
    font-size: var(--text-xs);
    line-height: 1.4;
    box-shadow: var(--shadow-lift);
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--mint);
  }

  .chat-head :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .chat-ref {
    font-weight: 700;
  }

  .section-title {
    margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .feature {
    padding: 1.25rem 1.25rem 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--yarn-soft);
  }

  .feature h3 {
    margin-bottom: 0.35rem;
    font-size: var(--text-md);
    color: var(--yarn-deep);
  }

  .feature p,
  .steps p,
  .addons p:not(.addon-head) {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem;
  }

  .steps h3 {
    margin: 0.6rem 0 0.25rem;
    font-size: var(--text-md);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--marigold-bright);
    font-family: var(--font-display);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    align-items: start;
    gap: 1rem;
  }

  .plan {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 2px solid var(--yarn-soft);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .plan-popular {
    border-color: var(--yarn-bright);
    box-shadow: var(--shadow-lift);
  }

  .plan-badge {
    justify-self: start;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: var(--yarn-soft);
    color: var(--yarn-deep);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plan-name {
    font-size: var(--text-xl);
    color: var(--yarn-deep);
  }

  .plan-price {
    font-size: var(--text-2xl);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .plan-price span {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
  }

  .plan-blurb {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .plan-list {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .plan-list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .plan-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 800;
    color: var(--yarn-deep);
  }

  .addons-title {
    margin: 2rem 0 0.9rem;
    font-size: var(--text-lg);
  }

  .addons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.75rem;
  }

  .addons li {
    padding: 1rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .addon-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.3rem;
  }

  .addon-head span {
    font-weight: 700;
    color: var(--berry);
    white-space: nowrap;
  }

  .faqs {
    display: grid;
    gap: 0.6rem;
    max-width: 48rem;
  }

  .faq {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .faq h3 {
    font-size: var(--text-md);
  }

  .faq p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
  }

  .outro {
    margin-top: calc(var(--section) + 12px);
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .outro-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .outro-inner .section-title {
    margin-bottom: 0;
  }

  .outro-inner p {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .topbar-print {
    display: none;
  }

  /* Printing (or Save as PDF) gives a compact handout to send on WhatsApp. */
  @media print {
    @page {
      margin: 12mm;
    }

    body {
      background: #fff;
      font-size: 11pt;
    }

    .topbar .text-link,
    .intro-actions,
    .outro .btn {
      display: none;
    }

    .intro,
    .outro {
      padding-block: 0.5rem;
      margin-top: 0.75rem;
    }

    .scallop-top::before,
    .scallop-bottom::after {
      display: none;
    }

    .intro-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 1.5rem;
    }

    .intro-title {
      font-size: 24pt;
    }

    .section {
      padding-top: 0.9rem;
    }

    .section-title {
      margin-bottom: 0.5rem;
      font-size: 16pt;
    }

    .features,
    .plans {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .feature,
    .plan,
    .addons li,
    .faq {
      padding: 0.6rem 0.75rem;
      break-inside: avoid;
    }

    .steps,
    .addons {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .plan-popular {
      box-shadow: none;
    }

    .steps li,
    .plans,
    .addons {
      break-inside: avoid;
    }

    .plan-price {
      font-size: 18pt;
    }

    .plan-list,
    .plan-blurb,
    .feature p,
    .steps p,
    .addons p:not(.addon-head),
    .faq p {
      font-size: 9pt;
      line-height: 1.4;
    }

    .intro-media :global(.intro-img) {
      aspect-ratio: 4 / 3;
    }

    .addons-title {
      margin-top: 0.75rem;
    }

    /* Page 1: the pitch. Page 2: plans, add-ons, questions and contact. */
    section[aria-labelledby='plans-title'] {
      break-before: page;
      padding-top: 0;
    }

    .faq {
      padding: 0.35rem 0.75rem;
    }

    .faq h3 {
      font-size: 10pt;
    }

    .faqs {
      gap: 0.25rem 0.75rem;
    }

    /* The handout skips the questions the plan and add-on cards already answer. */
    .faqs {
      grid-template-columns: repeat(3, 1fr);
      max-width: none;
    }

    .faq-screen-only {
      display: none;
    }

    /* The contact line moves to the top of the handout instead of the closing band. */
    .topbar-print {
      display: block;
      font-weight: 700;
    }

    .topbar-print a {
      color: var(--berry);
      text-underline-offset: 0.15em;
    }

    .outro {
      display: none;
    }

    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
