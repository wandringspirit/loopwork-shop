---
// Fallback for /for-sellers/. On the live site worker/index.js answers this address first and
// shows the ₹ or USD page by country; this page only shows during `npm run dev` / `npm run
// preview`, or if the Worker is missing. It follows ?region=in|intl, or guesses from the
// browser's time zone, and offers both links.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A shop website for your handmade business</title>
    <script is:inline>
      var region = new URLSearchParams(location.search).get('region');
      var zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      var india = region ? region === 'in' : zone === 'Asia/Kolkata' || zone === 'Asia/Calcutta';
      location.replace(india ? '/for-sellers/india/' : '/for-sellers/international/');
    </script>
  </head>
  <body>
    <p><a href="/for-sellers/india/">In India: prices in ₹</a></p>
    <p><a href="/for-sellers/international/">Everywhere else: prices in USD</a></p>
  </body>
</html>
