---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage from '../assets/site/about.jpg';
import customImage from '../assets/site/custom.jpg';
import heroImage from '../assets/site/hero.jpg';
import { categoryColours, getCategories, getListedProducts, productUrl } from '../lib/catalog';
import { formatPrice, plural } from '../lib/format';
import { statusLabels } from '../lib/status';
import { site } from '../site.config';

/** The product pictured in the hero photo; its price tag is shown on the photo. */
const HERO_PRODUCT_ID = 'carrot-bunny';

const [categories, products, faqs] = await Promise.all([
  getCategories(),
  getListedProducts(),
  getCollection('faq', ({ data }) => data.onHome),
]);

const categoryName = new Map(categories.map((category) => [category.id, category.data.name]));
const colourOf = categoryColours(categories);
const featured = products.filter((product) => product.data.featured).slice(0, 4);
const heroProduct = products.find((product) => product.id === HERO_PRODUCT_ID);

const tiles = categories.flatMap((category) => {
  const items = products.filter((product) => product.data.category.id === category.id);
  const cover = items.find((product) => product.id === category.data.coverProduct) ?? items[0];
  return cover ? [{ category, count: items.length, photo: cover.data.photos[0], colour: colourOf(category.id) }] : [];
});
---

<BaseLayout>
  <section class="hero-band band scallop-bottom yarn-marigold">
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow">Handmade crochet · Made in {site.country}</p>
        <h1 class="display hero-title">Soft things, made one loop at a time.</h1>
        <p class="hero-lede">
          Toys, bags, hats and little comforts for home, each one crocheted by hand. Fill your cart, send an order
          request, and we'll sort out the details together on WhatsApp.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/shop/">Shop all pieces</a>
          <a class="btn btn-outline" href="/custom-orders/">Request a custom piece</a>
        </div>
        <dl class="hero-facts">
          <div class="yarn-berry">
            <dt class="yarn-dot">No payment online</dt>
            <dd>You pay once we confirm</dd>
          </div>
          <div class="yarn-teal">
            <dt class="yarn-dot">Made by hand</dt>
            <dd>Ready to ship or made for you</dd>
          </div>
          <div class="yarn-lilac">
            <dt class="yarn-dot">Ships {site.shipping.area}</dt>
            <dd>Charges confirmed before you pay</dd>
          </div>
        </dl>
      </div>

      <figure class="hero-media mount yarn-berry">
        <Image
          src={heroImage}
          alt={site.sitePhotos.hero.alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 60rem) 44vw, 100vw"
          priority
          class="hero-img"
        />
        {
          heroProduct && (
            <a class="hang-tag" href={productUrl(heroProduct.id)}>
              <span class="hang-tag-status">{statusLabels[heroProduct.data.status]}</span>
              <span class="hang-tag-name">{heroProduct.data.name}</span>
              <span class="hang-tag-price">{formatPrice(heroProduct.data.price)}</span>
            </a>
          )
        }
      </figure>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="categories-title">
    <div class="section-head">
      <h2 id="categories-title" class="display section-title">Shop by category</h2>
      <a class="text-link" href="/shop/">See all {plural(products.length, 'piece')}</a>
    </div>
    <ul class="tiles" role="list">
      {
        tiles.map(({ category, count, photo, colour }) => (
          <li>
            <a class:list={['tile', `yarn-${colour}`]} href={`/shop/?category=${category.id}`}>
              <Image
                src={photo.src}
                alt=""
                widths={[360, 540, 720]}
                sizes="(min-width: 70rem) 290px, (min-width: 48rem) 23vw, 70vw"
                class="tile-img"
                style={photo.focus ? `object-position: ${photo.focus}` : undefined}
              />
              <span class="tile-text">
                <span class="tile-name">{category.data.name}</span>
                <span class="tile-count">{plural(count, 'piece')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured.length > 0 && (
      <section class="section wrap" aria-labelledby="featured-title">
        <div class="section-head">
          <div class="head-copy">
            <h2 id="featured-title" class="display section-title">
              Featured pieces
            </h2>
            <p class="section-lede">A few favourites, ready to ship or made just for you.</p>
          </div>
          <a class="text-link" href="/shop/">
            Browse the shop
          </a>
        </div>
        <div class="product-grid">
          {featured.map((product) => (
            <ProductCard
              product={product}
              categoryName={categoryName.get(product.data.category.id) ?? ''}
              colour={colourOf(product.data.category.id)}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="how band scallop-top scallop-bottom yarn-lilac" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <div class="head-copy">
          <p class="eyebrow">How ordering works</p>
          <h2 id="how-title" class="display section-title">No checkout. Just a friendly chat.</h2>
        </div>
        <a class="text-link" href="/faq/">Read the FAQ</a>
      </div>
      <ol class="steps" role="list">
        <li class="step">
          <span class="step-number" aria-hidden="true">1</span>
          <h3>Fill your cart</h3>
          <p>Pick colours and sizes, then add the pieces you love.</p>
        </li>
        <li class="step">
          <span class="step-number" aria-hidden="true">2</span>
          <h3>Send your order request</h3>
          <p>Add your delivery details. You'll get an order number straight away.</p>
        </li>
        <li class="step">
          <span class="step-number" aria-hidden="true">3</span>
          <h3>Confirm on WhatsApp, then pay</h3>
          <p>We confirm availability and shipping, you pay by {site.payment}, and your parcel is on its way.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section wrap split" aria-labelledby="custom-title">
    <div class="split-media mount yarn-coral">
      <Image
        src={customImage}
        alt={site.sitePhotos.custom.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 60rem) 45vw, 100vw"
        class="split-img"
      />
    </div>
    <div class="split-copy">
      <p class="eyebrow">Custom orders</p>
      <h2 id="custom-title" class="display section-title">Have something in mind?</h2>
      <p>
        A bunny in your favourite colour, a name on a blanket, a gift for someone who has everything. Tell us your idea and
        we'll plan it together on WhatsApp before anything is made.
      </p>
      <a class="btn btn-primary" href="/custom-orders/">Start a custom order</a>
    </div>
  </section>

  <section class="section wrap split split-reverse" aria-labelledby="about-title">
    <div class="split-media mount mount-left yarn-teal">
      <Image
        src={aboutImage}
        alt={site.sitePhotos.about.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 60rem) 45vw, 100vw"
        class="split-img"
      />
    </div>
    <div class="split-copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title" class="display section-title">Made slowly, on purpose</h2>
      <p>
        Every piece starts as a ball of yarn and a hook. Nothing is mass-produced, so no two pieces are ever quite the
        same. That's the point.
      </p>
      <a class="text-link" href="/about/">Read our story</a>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="faq-band band scallop-top scallop-bottom yarn-mint" aria-labelledby="faq-title">
        <div class="wrap faq-teaser">
          <div class="faq-teaser-head">
            <h2 id="faq-title" class="display section-title">
              Good to know
            </h2>
            <p>
              More answers in the <a class="text-link" href="/faq/">FAQ</a>, or <a class="text-link" href="/contact/">ask us</a>.
            </p>
          </div>
          <div class="faq-teaser-list">
            {faqs.map((item) => (
              <details class="faq-item">
                <summary>{item.data.question}</summary>
                <p>{item.data.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero-band {
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .hero {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-top: clamp(1.75rem, 1rem + 3vw, 3.75rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .hero-title {
    max-width: 14ch;
    font-size: clamp(2.25rem, 1.3rem + 4.8vw, 5.25rem);
  }

  /* On phones the photo comes first and the copy tightens up, so the first screen shows
     what the shop sells instead of a wall of text. */
  @media (max-width: 59.99rem) {
    .hero {
      gap: 1.5rem;
      padding-top: 1.25rem;
    }

    .hero-media {
      order: -1;
    }

    .hero .hero-media :global(.hero-img) {
      aspect-ratio: 5 / 4;
      max-height: 55svh;
    }

    .hero .hang-tag {
      top: 0.75rem;
      right: 0.75rem;
      bottom: auto;
      left: auto;
      min-width: 0;
      padding: 0.55rem 0.9rem 0.6rem 1.8rem;
    }

    .hero .hang-tag::before {
      left: 0.65rem;
    }

    .hero .hero-copy {
      gap: 1rem;
    }

    .hero .hero-actions {
      width: 100%;
    }

    .hero .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }

    .hero .hero-facts {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 0.25rem;
      padding-top: 1.1rem;
    }

    .hero .hero-facts > div {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.35rem;
    }

    .hero .hero-facts dd {
      padding-left: 0;
    }

    .hero .hero-facts dd::before {
      content: '· ';
    }
  }

  .hero-lede {
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 1.5rem;
    width: 100%;
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-facts dt {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Lines the second line up with the label text, past the yarn dot. */
  .hero-facts dd {
    padding-left: 1.05rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .hero-media :global(.hero-img) {
    width: 100%;
    max-height: 42rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* A paper price tag, punched and tied on like the ones on handmade goods. */
  .hang-tag {
    position: absolute;
    left: -1rem;
    bottom: 2.5rem;
    display: grid;
    gap: 0.1rem;
    min-width: 11.5rem;
    padding: 0.85rem 1.2rem 0.9rem 2.2rem;
    border-radius: 6px 14px 14px 6px;
    background: var(--paper);
    box-shadow: var(--shadow-lift);
    text-decoration: none;
    transform: rotate(-3deg);
    transition: transform 0.35s var(--ease);
  }

  .hang-tag::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.8rem;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: -0.3rem;
    border-radius: 50%;
    background: var(--marigold-soft);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }

  .hang-tag:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  .hang-tag-status {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mint);
  }

  .hang-tag-name {
    font-weight: 700;
  }

  .hang-tag-price {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  @media (max-width: 40rem) {
    .hang-tag {
      left: 0.75rem;
      bottom: 0.75rem;
    }
  }

  .head-copy {
    display: grid;
    gap: 0.6rem;
  }

  .tiles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(12.5rem, 68%);
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x mandatory;
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
    }
  }

  .tiles li {
    scroll-snap-align: start;
  }

  /* Each category sits on a card of its own yarn colour, which brightens on hover. */
  .tile {
    display: grid;
    gap: 0.8rem;
    padding: 0.55rem 0.55rem 0.95rem;
    border-radius: var(--radius-lg);
    background: var(--yarn-soft);
    text-decoration: none;
    transition: background-color 0.3s var(--ease);
  }

  .tile:hover {
    background: var(--yarn-bright);
  }

  .tile :global(.tile-img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 0.55rem);
  }

  .tile-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.5rem;
    padding-inline: 0.4rem;
  }

  .tile-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .tile-count {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--yarn-deep);
    font-size: var(--text-xs);
    font-weight: 700;
    white-space: nowrap;
  }

  .how {
    margin-top: calc(var(--section) + var(--scallop));
    padding-block: var(--section);
  }

  .split {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1rem + 3vw, 4.5rem);
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .split-reverse .split-media {
      order: 2;
    }
  }

  .split :global(.split-img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .split-copy {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 34rem;
  }

  .split-copy p:not(.eyebrow) {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .faq-band {
    margin-top: calc(var(--section) + var(--scallop));
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .faq-teaser {
    display: grid;
    gap: 1.5rem 4rem;
  }

  @media (min-width: 60rem) {
    .faq-teaser {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .faq-teaser-head {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .faq-teaser-head p {
    color: var(--ink-soft);
  }

  .faq-teaser-list {
    border-top: 1px solid var(--line);
  }
</style>
