---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({ params: { slug: policy.id }, props: { policy } }));
}

interface Props {
  policy: CollectionEntry<'policies'>;
}

const { policy } = Astro.props;
const [{ Content }, policies] = await Promise.all([render(policy), getCollection('policies')]);
const updated = policy.data.updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const menuOrder = ['shipping', 'returns', 'privacy', 'terms'];
const others = policies
  .filter((entry) => entry.id !== policy.id)
  .sort((a, b) => menuOrder.indexOf(a.id) - menuOrder.indexOf(b.id));
---

<BaseLayout title={policy.data.title} description={policy.data.summary}>
  <PageHeader title={policy.data.title} eyebrow="Policies" colour="teal">
    <p class="policy-updated">Last updated {updated}</p>
    {policy.data.draft && <p class="notice notice-draft">Draft: this policy is still being finalised.</p>}
  </PageHeader>

  <article class="wrap policy">
    <div class="prose">
      <Content />
    </div>

    <nav class="policy-nav" aria-labelledby="other-policies-title">
      <h2 id="other-policies-title" class="block-title">Other policies</h2>
      <ul role="list">
        {
          others.map((entry) => (
            <li>
              <a href={`/policies/${entry.id}/`}>{entry.data.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</BaseLayout>

<style>
  .policy {
    padding-top: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
  }

  .policy-updated {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .policy-nav {
    display: grid;
    gap: 0.75rem;
    max-width: 42rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .policy-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .policy-nav a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .policy-nav a:hover {
    color: var(--berry);
  }
</style>
