---
// Fallback for /sell. On the live site worker/index.js answers /sell first and redirects by
// country; this page only shows during `npm run dev` / `npm run preview`, or if the Worker is
// missing. It guesses from the browser's time zone instead, and offers both links.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Shop websites for handmade sellers</title>
    <script is:inline>
      var zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      var india = zone === 'Asia/Kolkata' || zone === 'Asia/Calcutta';
      location.replace(india ? '/for-sellers/' : '/for-sellers/international/');
    </script>
  </head>
  <body>
    <p><a href="/for-sellers/">In India: prices in ₹</a></p>
    <p><a href="/for-sellers/international/">Everywhere else: prices in USD</a></p>
  </body>
</html>
