---
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryColours, getCategories, getListedProducts } from '../../lib/catalog';
import { plural } from '../../lib/format';

const [categories, products] = await Promise.all([getCategories(), getListedProducts()]);
const categoryName = new Map(categories.map((category) => [category.id, category.data.name]));
const colourOf = categoryColours(categories);
const filters = categories
  .map((category) => ({
    id: category.id,
    name: category.data.name,
    colour: colourOf(category.id),
    count: products.filter((product) => product.data.category.id === category.id).length,
  }))
  .filter((filter) => filter.count > 0);
---

<BaseLayout
  title="Shop"
  description="Browse handmade crochet toys, bags, wearables and homeware. Ready-to-ship and made-to-order pieces."
>
  <PageHeader title="The shop" eyebrow={plural(products.length, 'piece')} colour="berry">
    <p class="page-lede">
      Everything is crocheted by hand. <strong>Ready to ship</strong> pieces leave within a few days, and
      <strong>made to order</strong> pieces are started just for you.
    </p>
  </PageHeader>

  <div class="wrap toolbar" data-shop-toolbar>
    <div class="chips" role="group" aria-label="Filter by category">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">
        All <span class="chip-count">{products.length}</span>
      </button>
      {
        filters.map((filter) => (
          <button
            type="button"
            class:list={['chip', 'yarn-dot', `yarn-${filter.colour}`]}
            data-filter={filter.id}
            aria-pressed="false"
          >
            {filter.name} <span class="chip-count">{filter.count}</span>
          </button>
        ))
      }
    </div>
    <label class="sort">
      <span class="sort-label">Sort by</span>
      <select class="input sort-select" data-sort>
        <option value="featured">Featured</option>
        <option value="price-asc">Price: low to high</option>
        <option value="price-desc">Price: high to low</option>
      </select>
    </label>
  </div>

  <section class="wrap" aria-label="Products">
    <p class="visually-hidden" role="status" data-shop-status></p>
    <div class="product-grid" data-grid>
      {
        products.map((product, index) => (
          <ProductCard
            product={product}
            categoryName={categoryName.get(product.data.category.id) ?? ''}
            colour={colourOf(product.data.category.id)}
            eager={index < 4}
            headingLevel="h2"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    padding-block: 0.75rem;
    background: var(--cotton);
  }

  .chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.6rem;
    padding: 0.4rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .chip:hover {
    border-color: var(--yarn-deep, var(--ink));
  }

  /* The chosen filter fills with its category colour ("All" uses ink). */
  .chip[aria-pressed='true'] {
    border-color: var(--yarn-deep, var(--ink));
    background: var(--yarn-deep, var(--ink));
    color: #fff;
  }

  .chip[aria-pressed='true']::before {
    background: #fff;
  }

  .chip-count {
    font-size: var(--text-xs);
    font-weight: 500;
    opacity: 0.75;
  }

  .chip[aria-pressed='true'] .chip-count {
    opacity: 0.9;
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .sort-select {
    width: auto;
    min-height: 2.6rem;
    padding-block: 0.4rem;
    border-radius: 999px;
  }
</style>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-shop-toolbar]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const status = document.querySelector<HTMLElement>('[data-shop-status]');

  if (toolbar && grid && status) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    const chips = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const sort = toolbar.querySelector<HTMLSelectElement>('[data-sort]')!;
    const featuredOrder = new Map(cards.map((card, index) => [card, index]));

    const apply = (category: string, sortBy: string, announce = true) => {
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === category)));

      let visible = 0;
      for (const card of cards) {
        card.hidden = category !== 'all' && card.dataset.category !== category;
        if (!card.hidden) visible += 1;
      }

      const sorted = [...cards].sort((a, b) => {
        if (sortBy === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (sortBy === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
        return featuredOrder.get(a)! - featuredOrder.get(b)!;
      });
      grid.append(...sorted);

      if (announce) status.textContent = `Showing ${visible} ${visible === 1 ? 'piece' : 'pieces'}`;

      // Keep the choice in the address so the view can be shared or bookmarked.
      const params = new URLSearchParams(location.search);
      if (category === 'all') params.delete('category');
      else params.set('category', category);
      if (sortBy === 'featured') params.delete('sort');
      else params.set('sort', sortBy);
      const query = params.toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}`);
    };

    const params = new URLSearchParams(location.search);
    const requestedCategory = params.get('category');
    const requestedSort = params.get('sort');
    const initialCategory = chips.some((chip) => chip.dataset.filter === requestedCategory) ? requestedCategory! : 'all';
    const initialSort = requestedSort === 'price-asc' || requestedSort === 'price-desc' ? requestedSort : 'featured';
    sort.value = initialSort;
    apply(initialCategory, initialSort, false);

    chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter!, sort.value)));
    sort.addEventListener('change', () => {
      const active = chips.find((chip) => chip.getAttribute('aria-pressed') === 'true');
      apply(active?.dataset.filter ?? 'all', sort.value);
    });
  }
</script>
