{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The demo shop at loopwork.leadspilot.co. `npm run starter` resets the name, account and route for a client.
  "name": "loopwork-demo",
  // the Cloudflare account that owns leadspilot.co (leadpilot01@gmail.com): a login to another account fails
  "account_id": "53053160af6109a9f82d179922a6c7b4",
  "compatibility_date": "2026-09-01",
  // Only /sell runs this code (it picks the ₹ or USD sales page by country); everything else is static.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/sell", "/sell/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "loopwork.leadspilot.co", "custom_domain": true }],
  "observability": { "enabled": true }
}
